{
  "name": "@keepithandy/pulse-engine",
  "version": "0.1.0-alpha.0",
  "description": "A deterministic, event-driven JavaScript simulation engine.",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "pulse-run": "./bin/pulse-run.js"
  },
  "files": [
    "src",
    "bin",
    "scenarios",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:types": "node tools/check-types.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.js --test-coverage-lines=80 --test-coverage-functions=85 --test-coverage-branches=70",
    "lint": "node tools/check-source.mjs",
    "smoke": "node bin/pulse-run.js --scenario scenarios/resource-network.json --ticks 100",
    "check:package": "node tools/check-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keepithandy/pulse-engine.git"
  },
  "homepage": "https://github.com/keepithandy/pulse-engine#readme",
  "bugs": {
    "url": "https://github.com/keepithandy/pulse-engine/issues"
  },
  "keywords": [
    "simulation",
    "deterministic",
    "event-driven",
    "game-engine",
    "typescript",
    "scheduler"
  ]
}
